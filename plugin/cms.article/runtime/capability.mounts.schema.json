{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Managed Capability Mount Registry",
  "type": "object",
  "properties": {
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slotKey": { "type": "string" },
          "providerPlugin": { "type": "string" },
          "serviceXid": { "type": "string" },
          "status": { "type": "string" },
          "note": { "type": "string" },
          "mount": {
            "type": "object",
            "properties": {
              "surface": { "type": "string" },
              "mode": { "type": "string" }
            },
            "additionalProperties": true
          },
          "adminEntry": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "href": { "type": "string" }
            },
            "additionalProperties": true
          },
          "publicEntry": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "href": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "required": ["slotKey"],
        "additionalProperties": true
      }
    }
  },
  "required": ["mounts"],
  "additionalProperties": false
}
