{
  "groups": [
    {
      "key": "access",
      "title": "阅读权限选项",
      "fields": [
        {
          "name": "passwordHashIterations",
          "type": "number",
          "label": "密码哈希迭代次数",
          "value": 200
        },
        {
          "name": "maxPasswordInputBytes",
          "type": "number",
          "label": "密码输入字节上限",
          "value": 128,
          "min": 1,
          "max": 512,
          "step": 1
        },
        {
          "name": "maxRequestBytes",
          "type": "number",
          "label": "后台请求体字节上限",
          "value": 65536,
          "min": 512,
          "max": 262144,
          "step": 512
        },
        {
          "name": "paidSessionKey",
          "type": "input",
          "label": "付费内容 Session 字段",
          "value": "paidContentIds",
          "placeholder": "paidContentIds"
        },
        {
          "name": "allowQueryReadLevel",
          "type": "switch",
          "label": "允许调试参数覆盖阅读等级",
          "value": false
        },
        {
          "name": "maxReadLevel",
          "type": "number",
          "label": "阅读等级上限",
          "value": 100,
          "min": 1,
          "max": 1000000,
          "step": 1
        },
        {
          "name": "maxListRows",
          "type": "number",
          "label": "后台规则列表上限",
          "value": 500,
          "min": 1,
          "max": 1000,
          "step": 1
        }
      ]
    }
  ]
}
