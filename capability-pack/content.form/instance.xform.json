{
  "groups": [
    {
      "key": "form-protection",
      "title": "表单提交防刷选项",
      "fields": [
        {
          "name": "ipWindowSeconds",
          "type": "number",
          "label": "同 IP 限流窗口秒数",
          "value": 60
        },
        {
          "name": "ipWindowLimit",
          "type": "number",
          "label": "同 IP 限流次数",
          "value": 20
        },
        {
          "name": "minSubmitSeconds",
          "type": "number",
          "label": "最短提交耗时秒数",
          "value": 2,
          "min": 0,
          "max": 60,
          "step": 1
        },
        {
          "name": "maxSubmissionBytes",
          "type": "number",
          "label": "默认提交大小上限字节",
          "value": 262144,
          "min": 1024,
          "max": 1048576,
          "step": 1024
        },
        {
          "name": "maxRequestBytes",
          "type": "number",
          "label": "请求体字节上限",
          "value": 262144,
          "min": 1024,
          "max": 1048576,
          "step": 1024
        },
        {
          "name": "maxFields",
          "type": "number",
          "label": "表单字段数量上限",
          "value": 100,
          "min": 1,
          "max": 500,
          "step": 1
        },
        {
          "name": "maxListRows",
          "type": "number",
          "label": "后台列表最大行数",
          "value": 500,
          "min": 50,
          "max": 1000
        },
        {
          "name": "maxExportRows",
          "type": "number",
          "label": "提交导出最大行数",
          "value": 5000,
          "min": 100,
          "max": 10000
        },
        {
          "name": "maxNotificationStatEvents",
          "type": "number",
          "label": "通知统计事件上限",
          "value": 50,
          "min": 1,
          "max": 200
        }
      ]
    }
  ]
}
