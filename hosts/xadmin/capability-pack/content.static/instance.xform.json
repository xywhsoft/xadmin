{
  "groups": [
    {
      "key": "static",
      "title": "静态化选项",
      "fields": [
        {
          "name": "outputDir",
          "type": "input",
          "label": "输出目录",
          "value": "content"
        },
        {
          "name": "autoGenerate",
          "type": "switch",
          "label": "发布后自动生成",
          "value": true
        },
        {
          "name": "autoClean",
          "type": "switch",
          "label": "删除后自动清理",
          "value": true
        },
        {
          "name": "autoGenerateRuleLimit",
          "type": "number",
          "label": "自动生成规则上限",
          "value": 20,
          "min": 1,
          "max": 200,
          "step": 1
        },
        {
          "name": "maxListRows",
          "type": "number",
          "label": "列表行数上限",
          "value": 500,
          "min": 1,
          "max": 1000,
          "step": 1
        },
        {
          "name": "maxCleanRows",
          "type": "number",
          "label": "单次清理产物数",
          "value": 500,
          "min": 1,
          "max": 5000,
          "step": 1
        },
        {
          "name": "maxTaskRetryRows",
          "type": "number",
          "label": "失败任务重试上限",
          "value": 20,
          "min": 1,
          "max": 100,
          "step": 1
        },
        {
          "name": "maxGenerateRequestBytes",
          "type": "number",
          "label": "生成请求体字节上限",
          "value": 8192,
          "min": 512,
          "max": 65536,
          "step": 512
        },
        {
          "name": "maxRequestBytes",
          "type": "number",
          "label": "后台请求体字节上限",
          "value": 65536,
          "min": 512,
          "max": 262144,
          "step": 512
        }
      ]
    }
  ]
}
