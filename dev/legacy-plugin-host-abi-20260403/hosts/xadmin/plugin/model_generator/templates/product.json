{
    "templateId": "product",
    "templateTitle": "产品系统",
    "templateDesc": "商品产品管理",
    "templateIcon": "layui-icon layui-icon-cart-simple",
    "config": {
        "namespace": "ecommerce",
        "modelName": "product",
        "modelTitle": "产品",
        "features": {
            "enableApi": true,
            "enableAdmin": true,
            "enableSubmit": false,
            "enableReply": true,
            "enableAccessControl": false
        },
        "fields": [
            {
                "name": "name",
                "type": "TEXT",
                "label": "产品名称",
                "required": true,
                "maxLength": 200,
                "searchable": true,
                "showInList": true,
                "showInForm": true
            },
            {
                "name": "description",
                "type": "TEXT",
                "label": "产品描述",
                "widget": "editor",
                "showInList": true,
                "showInForm": true
            },
            {
                "name": "price",
                "type": "REAL",
                "label": "价格",
                "required": true,
                "widget": "number",
                "showInList": true,
                "showInForm": true
            },
            {
                "name": "stock",
                "type": "INTEGER",
                "label": "库存",
                "defaultValue": 0,
                "showInList": true,
                "showInForm": true
            },
            {
                "name": "images",
                "type": "TEXT",
                "label": "产品图片",
                "widget": "images",
                "showInList": false,
                "showInForm": true
            },
            {
                "name": "category",
                "type": "INTEGER",
                "label": "分类",
                "widget": "select",
                "showInList": true,
                "showInForm": true
            },
            {
                "name": "status",
                "type": "INTEGER",
                "label": "状态",
                "widget": "radio",
                "defaultValue": 0,
                "options": [
                    {"value": 0, "label": "下架"},
                    {"value": 1, "label": "上架"},
                    {"value": 2, "label": "预售"}
                ],
                "showInList": true,
                "showInForm": true
            }
        ]
    }
}
